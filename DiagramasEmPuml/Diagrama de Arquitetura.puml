@startuml

left to right direction
skinparam componentStyle rectangle

actor "Adotante" as Adotante
actor "ONG/Abrigo/Protetor" as ONG

package "Sistema PetCar" {

  [Interface Web] as Web

  [Camada de Controle\nControllers] as Controllers

  [Camada de Serviço\nRegras de Negócio] as Services

  [Camada de Persistência\nRepositories/DAOs] as Repositories

  database "Banco de Dados" as BD
}

Adotante --> Web
ONG --> Web

Web --> Controllers
Controllers --> Services
Services --> Repositories
Repositories --> BD

@enduml